# Start without model keys; configure them in Admin > Model Settings. UTF-8.
# Admin origin must exactly match your browser origin (including a custom port).
MODEL_ADMIN_ORIGIN=http://localhost
# Docker binds published ports to loopback. HTTPS reverse proxy is required for remote access.
# Optional legacy text fallback (web database configuration has priority).
DASHSCOPE_API_KEY=
# Optional enhancement: choose Gemini OR Doubao; neither is needed for DEMO.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-image
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
DOUBAO_API_KEY=
# Copy the image model/endpoint ID enabled in YOUR Ark console, not a chat model.
DOUBAO_MODEL=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_IMAGE_SIZE=2K
IMAGE_TIMEOUT_SECONDS=120
# Legacy IMAGE_MODEL_API_KEY / IMAGE_MODEL remain supported by the backend.
TEXT_MODEL=qwen-plus
TEXT_MODEL_BASE_URL=https://dashscope.aliyuncs.com
IMAGE_STORAGE=local
# Generate with node tools/init-local-env.mjs; do not use a production default password.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ai_passage_creator
FRONTEND_PORT=80
BACKEND_PORT=8123
# Optional legacy services. Leave blank for local storage.
PEXELS_API_KEY=
# IMAGE_STORAGE=cos
# TENCENT_COS_SECRET_ID=
# TENCENT_COS_SECRET_KEY=
# TENCENT_COS_REGION=
# TENCENT_COS_BUCKET=

# Opt in after applying migrations to experience review + manual operations + recovery.
REVIEW_LOOP_ENABLED=false
INTERVENTION_ENABLED=false
RUNTIME_ENABLED=false
